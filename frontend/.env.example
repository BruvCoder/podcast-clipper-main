VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- Google Analytics 4 ---
# The production measurement ID is a constant in src/analytics.js, so nothing
# needs to be set here for a normal deploy. It is a public identifier that ships
# in the built bundle and can be read off the live site, not a secret.
#
# Local development is excluded by hostname, so `npm run dev` never sends hits
# to the real property regardless of this setting.
#
# Set this only to point a build at a DIFFERENT GA4 property, e.g. a staging
# stream. Vite inlines VITE_* at BUILD time, so it must be present before
# `npm run build`; setting it on a running container changes nothing.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
