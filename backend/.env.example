# --- YouTube downloading (direct yt-dlp) ---
# Install yt-dlp and ffmpeg on PATH for local development. The production
# Dockerfile pins and checksum-verifies the official yt-dlp Linux bundle.
# YTDLP_BINARY=yt-dlp
# Optional server-side Netscape cookie file for videos that require a logged-in
# YouTube session. Prefer a secret-mounted file on production hosts.
# YTDLP_COOKIES_FILE=/run/secrets/youtube-cookies.txt
# Local-only alternative, e.g. chrome or chrome:Default:
# YTDLP_COOKIES_FROM_BROWSER=chrome
# Resource and timeout limits. The download timeout is one overall source-
# preparation budget shared by metadata, retries, and the final download.
# YTDLP_METADATA_TIMEOUT_MS=120000
# YTDLP_DOWNLOAD_TIMEOUT_MS=1800000
# YTDLP_SOCKET_TIMEOUT_SEC=30
# YTDLP_MAX_DURATION_SEC=14400
# Aggregate cap across yt-dlp source fragments, inputs, and merged output:
# YTDLP_MAX_SOURCE_BYTES=2147483648
# YTDLP_MAX_HEIGHT=720
# YTDLP_CONCURRENT_FRAGMENTS=4
# YTDLP_SESSION_ATTEMPTS=3
# YTDLP_RETRY_BACKOFF_MS=250
# YTDLP_ROTATE_IPROYAL_SESSION=true
# IPRoyal's high-end streaming pool is plan-specific and opt-in:
# YTDLP_IPROYAL_STREAMING=false
# Production requires a configured residential proxy by default. Set false
# only if direct YouTube access from the production host is intentional.
# YTDLP_REQUIRE_PROXY=true
# Whole jobs are serialized by default to bound proxy, disk, Groq, and CPU use.
# JOB_PROCESS_CONCURRENCY=1
# Bound queued/running work accepted by the API:
# MAX_OUTSTANDING_JOBS=10
# MAX_OUTSTANDING_JOBS_PER_USER=2
# FFMPEG_RENDER_TIMEOUT_MS=300000

# --- Direct file uploads (POST /api/uploads) ---
# The file arrives as the request body and is streamed to disk, so nothing
# buffers in memory. Two separate limits, for two separate costs:
# bytes bound what Railway transfers and stores...
# UPLOAD_MAX_BYTES=524288000        # 500 MB
# ...and duration bounds what Groq transcribes, which file size does not imply:
# a heavily compressed three-hour recording can be smaller than a short
# high-bitrate one, and transcription is charged by length.
# UPLOAD_MAX_DURATION_SEC=7200      # 2 hours

# Optional processing overrides
# CLIP_PICKER_MODEL=openai/gpt-oss-120b   # model that selects and ranks clip moments
# CLIP_PICKER_TIMEOUT_MS=120000           # clip-selection request timeout
PORT=8787

# --- Ravi public-channel automation + clips publishing through Zernio ---
# A single server-side Zernio API key manages one deterministic clips profile
# per Ravi user, the hosted clips-channel connection flow, media uploads, and
# finished-clip publishing. Each profile holds one YouTube clips account. The
# public main channel is supplied as a URL/@handle and is never connected through
# Zernio. Keep this value backend-only.
# ZERNIO_API_KEY=your_zernio_api_key
# Exact frontend origin used for the post-connection return and CORS:
# APP_URL=http://localhost:5173
# Public backend origin used to build Ravi's clips-connection return URL:
# YOUTUBE_PUBLIC_API_URL=http://localhost:8787
# Optional explicit override. It defaults to:
# ${YOUTUBE_PUBLIC_API_URL}/api/youtube/oauth/callback
# YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8787/api/youtube/oauth/callback
# Production callback:
# YOUTUBE_OAUTH_REDIRECT_URI=https://api.vod-clipper.com/api/youtube/oauth/callback
# Optional Zernio overrides:
# ZERNIO_BASE_URL=https://zernio.com/api/v1
# ZERNIO_REQUEST_TIMEOUT_MS=20000
# ZERNIO_UPLOAD_TIMEOUT_MS=900000
# Official YouTube Atom-feed polling interval. Minimum: 60000 ms.
# YOUTUBE_WATCH_POLL_MS=60000
# One-time connection-state lifetime. Range: 60000-900000 ms.
# YOUTUBE_OAUTH_STATE_TTL_MS=600000
# Each Ravi user consumes one Zernio connected account for the clips channel.
# Production must provision enough connected-account capacity for expected users.

# --- Stripe subscription billing ---
# Pricing is removed from the current Ravi product. Keep billing disabled unless
# the dormant Checkout, Portal, webhook, and subscription gate are reactivated.
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_endpoint_signing_secret
# STRIPE_PRICE_ID=price_your_recurring_price
# STRIPE_ALLOW_PROMOTION_CODES=false

# --- Firebase Admin (backend authentication) ---
# Use exactly one of the following. For local development, download a service-account
# key from Firebase Console > Project settings > Service accounts, save it as
# backend/firebase-service-account.json, and use the path option below.
# Never commit the service-account file or paste real credentials into this template.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# For hosts that accept secrets only as environment variables, leave the path unset
# and provide the complete service-account JSON as a secret environment variable:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Groq (transcription + clip selection) ---
# One key covers both: Whisper large-v3 transcribes the audio (deriving word
# timestamps from real acoustic alignment, which is what keeps burned-in
# captions in sync), and a text model picks/ranks the clip moments.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional overrides:
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3   # or whisper-large-v3-turbo (faster, slightly less accurate)
# GROQ_TRANSCRIBE_TIMEOUT_MS=180000        # per-chunk request timeout
# GROQ_TRANSCRIBE_ATTEMPTS=4               # retries per chunk on transient API failures
# TRANSCRIBE_CHUNK_SEC=600    # seconds of audio per request; sized for the API's file-size limit, not timing accuracy
# TRANSCRIBE_CONCURRENCY=3    # how many chunks to transcribe at once

# --- Residential media proxy (optional locally; required in production by default) ---
# yt-dlp routes YouTube extraction and the source download through this proxy.
# Groq, Firebase, Zernio, Stripe, and other backend traffic remains direct.
# IPRoyal example: http://user:pass@geo.iproyal.com:12321
# Format: http://user:pass@host:port (https:// proxy endpoints are also supported)
# Credentials with reserved characters must be percent-encoded. Keep this in a
# deployment secret manager; it is backend-only and should never use VITE_... .
# RESIDENTIAL_PROXY_URL=
# Legacy alias: MEDIA_PROXY_URL=. If both are set, they must be identical.

# --- Rendering ---
# CLIP_RENDER_CONCURRENCY=   # how many clips to render with ffmpeg at once; defaults to (cpu cores - 1), capped at 4
# FFMPEG_THREADS=2           # per-ffmpeg-process thread cap — containers can misreport host-wide CPU counts, which over-threads libx264 into an OOM kill
