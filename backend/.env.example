# --- YouTube downloading (two RapidAPI providers) ---
# One RapidAPI account/key, subscribed (free tiers are fine) to both:
#   - "Cloud API Hub - YouTube Downloader"  -> gives the video-only stream URL
#   - "YouTube MP3"                          -> gives the audio track (downloaded in full)
# The video is never downloaded in full: each rendered clip has ffmpeg seek
# directly into the video-only URL for just its own time window.
RAPIDAPI_KEY=your_rapidapi_key_here
# Optional overrides if you point at different RapidAPI listings for these:
# VIDEO_RAPIDAPI_HOST=cloud-api-hub-youtube-downloader.p.rapidapi.com
# AUDIO_RAPIDAPI_HOST=youtube-mp36.p.rapidapi.com
# Optional timeout overrides (milliseconds):
# RAPIDAPI_TIMEOUT_MS=30000
# DOWNLOAD_INACTIVITY_TIMEOUT_MS=45000
# DOWNLOAD_TOTAL_TIMEOUT_MS=1800000
# PROBE_TIMEOUT_MS=45000
# METADATA_TIMEOUT_MS=15000
# TARGET_SHORT_EDGE=720
# FFMPEG_RENDER_TIMEOUT_MS=300000

# Gemini transcribes the audio (word-level timestamps) and picks which
# moments become clips. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite  # low-latency model used for transcription (many requests per episode)
# GEMINI_TIMEOUT_MS=60000               # clip-selection request timeout
# GEMINI_TRANSCRIBE_TIMEOUT_MS=120000   # per-chunk transcription request timeout
PORT=8787

# --- Firebase Admin (backend authentication) ---
# Use exactly one of the following. For local development, download a service-account
# key from Firebase Console > Project settings > Service accounts, save it as
# backend/firebase-service-account.json, and use the path option below.
# Never commit the service-account file or paste real credentials into this template.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# For hosts that accept secrets only as environment variables, leave the path unset
# and provide the complete service-account JSON as a secret environment variable:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Transcription (Gemini audio understanding, chunked per episode) ---
# TRANSCRIBE_CHUNK_SEC=360    # seconds of audio sent to Gemini per transcription request
# TRANSCRIBE_CONCURRENCY=3    # how many chunks to transcribe with Gemini at once

# --- Rendering ---
# CLIP_RENDER_CONCURRENCY=   # how many clips to render with ffmpeg at once; defaults to (cpu cores - 1), capped at 4
# FFMPEG_THREADS=2           # per-ffmpeg-process thread cap — containers can misreport host-wide CPU counts, which over-threads libx264 into an OOM kill
